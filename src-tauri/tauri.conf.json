{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v2/crates/tauri-config-schema/schema.json",
  "productName": "Openhead Office",
  "version": "1.0.0",
  "identifier": "org.openhead.office",
  "build": {
    "beforeDevCommand": "pnpm --filter @openhead/studio dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../apps/studio/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Openhead Office",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "copyright": "Copyright © 2026 Openhead Contributors. Apache-2.0 License.",
    "shortDescription": "Sovereign, Local-First Office Suite",
    "longDescription": "Openhead is a modern, high-performance office suite featuring Pen (Docs), Sum (Sheets), and Glimpse (Slides) with full XLSX/DOCX/PPTX fidelity, zero telemetry, and local-first AI.",
    "fileAssociations": [
      {
        "ext": ["docx", "odt"],
        "name": "Openhead Pen Document",
        "description": "Word Processing Document",
        "role": "Editor"
      },
      {
        "ext": ["xlsx", "ods", "csv"],
        "name": "Openhead Sum Spreadsheet",
        "description": "Spreadsheet Workbook",
        "role": "Editor"
      },
      {
        "ext": ["pptx", "odp"],
        "name": "Openhead Glimpse Presentation",
        "description": "Presentation Slide Deck",
        "role": "Editor"
      }
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libappindicator3-1"
        ]
      }
    }
  }
}
